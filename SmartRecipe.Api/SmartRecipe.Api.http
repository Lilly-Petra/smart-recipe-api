@SmartRecipe_Api_HostAddress = https://localhost:7202

# Get all recipes
GET {{SmartRecipe_Api_HostAddress}}/api/recipes
Accept: application/jsona

###
# Get a specific recipe by ID
GET {{SmartRecipe_Api_HostAddress}}/api/recipes/2
Accept: application/jsona

###
# Get a specific recipe by ID that does not exist
GET {{SmartRecipe_Api_HostAddress}}/api/recipes/19
Accept: application/jsona

###
# Create a recipe
POST {{SmartRecipe_Api_HostAddress}}/api/recipes
Content-Type: application/json

{
  "name": "Vegetable Curry",
  "mainIngredient": "Chickpeas"
}

###
# Get a newly created recipe by ID
GET {{SmartRecipe_Api_HostAddress}}/api/recipes/4
Accept: application/jsona

###
#Update a recipe
PUT {{SmartRecipe_Api_HostAddress}}/api/recipes/4
Content-Type: application/json

{
  "name": "Bean Curry",
  "mainIngredient": "Beans"
}

###
#delete a recipe
DELETE {{SmartRecipe_Api_HostAddress}}/api/recipes/4

###
#Verify that the recipe has been deleted  
GET {{SmartRecipe_Api_HostAddress}}/api/recipes/4  
Accept: application/jsona
